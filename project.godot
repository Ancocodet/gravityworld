; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Gravity World"
run/main_scene="res://scenes/menu.tscn"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.054902, 0.0745098, 0.101961, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="res://icons/splash_screen.png"
config/icon="res://icons/ic_launcher.png"

[autoload]

GameManager="*res://scripts/manager/game_manager.gd"
LeaderboardManager="*res://scripts/manager/leaderboard_manager.gd"
AccountManager="*res://scripts/manager/account_manager.gd"
GameData="*res://scripts/resources/game_data.gd"
SceneManager="*res://scripts/manager/scene_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/borderless=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
